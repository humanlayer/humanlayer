{
	"name": "@humanlayer/codex-humanlayer",
	"version": "0.1.1",
	"private": true,
	"description": "Mirror Codex CLI sessions, task files and HumanLayer tools to HumanLayer",
	"bin": {
		"humanlayer-codex": "./src/cli.ts"
	},
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --test \"test/**/*.test.ts\"",
		"check": "bun run typecheck && bun run test",
		"build": "bun scripts/build.ts"
	},
	"dependencies": {
		"@humanlayer/session-sdk-artifacts": "workspace:*",
		"@humanlayer/session-sdk-auth": "workspace:*",
		"@humanlayer/session-sdk-base": "workspace:*",
		"@humanlayer/session-sdk-diffs": "workspace:*",
		"@humanlayer/session-sdk-sessions": "workspace:*",
		"@humanlayer/session-sdk-tools": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"typescript": "^5.9.0"
	}
}
