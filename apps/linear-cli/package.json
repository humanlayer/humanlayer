{
  "name": "@humanlayer/linear-cli",
  "license": "Apache-2.0",
  "version": "0.8.0",
  "description": "Command line interface for Linear",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./commands/*": "./src/commands/*.ts",
    "./utils/*": "./src/utils/*.ts"
  },
  "bin": {
    "linear": "dist/linear"
  },
  "files": [
    "dist/linear",
    "README.md"
  ],
  "scripts": {
    "prepack": "rm -rf dist && bun run build",
    "build": "bun build ./src/cli.ts --compile --target=bun --outfile=dist/linear",
    "build:macos": "bun build ./src/cli.ts --compile --target=bun-darwin-arm64 --outfile=dist/linear",
    "build:linux": "bun build ./src/cli.ts --compile --target=bun-linux-x64 --outfile=dist/linear",
    "dev": "bun build ./src/cli.ts --compile --watch --target=bun-darwin-arm64 --outfile=dist/linear",
    "start": "bun run src/cli.ts",
    "test": "bun vitest run --project unit",
    "test:integration": "bun vitest run --project integration",
    "test:learning": "bun vitest run --project learning"
  },
  "dependencies": {
    "@linear/sdk": "^1.22.0",
    "chalk": "^4.1.2",
    "commander": "^9.4.1",
    "inquirer": "^8.2.5",
    "node-fetch": "^2.7.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@humanlayer/vitest-config": "workspace:*",
    "@types/bun": "^1.3.5",
    "@types/inquirer": "^8.2.5",
    "@types/node": "^18.11.9",
    "@types/node-fetch": "^2.6.13",
    "brace-expansion": ">=2.0.2",
    "effect": "catalog:",
    "ts-node": "^10.9.1",
    "typescript": "^4.8.4",
    "vitest": "catalog:"
  }
}
