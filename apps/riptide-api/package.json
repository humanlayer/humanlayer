{
  "name": "@humanlayer/riptide-api",
  "version": "0.0.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "exports": {
    "./lib/seat-sync": "./src/lib/seat-sync.ts",
    "./test-factory": "./test/test-factory.ts"
  },
  "scripts": {
    "dev": "bun --bun --env-file=../../.env run --watch src/index.ts",
    "dev:node-proxy": "bun --bun --env-file=../../.env run --watch src/index.ts",
    "build": "bun build ./src/index.ts ./src/instrument.mts --outdir ./dist --target node --format esm --sourcemap=linked --minify --external @sentry/node --external @sentry/core --entry-naming '[name].mjs'",
    "build:macos": "bun run build",
    "build:linux": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun --env-file=../../.env vitest run --project unit --project unit-isolated",
    "test:llm": "bun run ../../scripts/run-silent.ts 'tests passed' bun run test",
    "test:resend:live": "bun --env-file=../../.env vitest run --config vitest.resend-live.config.ts",
    "test:learning": "bun vitest run --project learning"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.7",
    "@ai-sdk/openai": "3.0.46",
    "@ai-sdk/provider": "3.0.10",
    "@aws-sdk/client-s3": "^3.1004.0",
    "@aws-sdk/s3-request-presigner": "^3.1004.0",
    "@humanlayer/ai": "workspace:*",
    "@humanlayer/billing": "workspace:*",
    "@humanlayer/db": "workspace:*",
    "@humanlayer/git-attribution": "workspace:*",
    "@humanlayer/logger": "workspace:*",
    "@humanlayer/riptide-api-contract": "workspace:*",
    "@humanlayer/test-fixtures": "workspace:*",
    "@distilled.cloud/aws": "1.0.0-rc.13",
    "@durable-streams/client": "catalog:",
    "@effect/opentelemetry": "catalog:",
    "@effect/platform-node": "catalog:",
    "@hono/node-server": "^1.14.1",
    "@humanlayer/effect-orpc": "workspace:*",
    "@humanlayer/fold-core": "0.1.32",
    "@humanlayer/schemas": "workspace:*",
    "@humanlayer/streams": "workspace:*",
    "@linear/sdk": "^78.0.0",
    "@opentelemetry/api-logs": "0.218.0",
    "@opentelemetry/resources": "2.7.1",
    "@opentelemetry/sdk-logs": "0.218.0",
    "@opentelemetry/sdk-metrics": "2.7.1",
    "@opentelemetry/sdk-trace-base": "2.7.1",
    "@opentelemetry/sdk-trace-node": "2.7.1",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/otel": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@sentry/core": "catalog:",
    "@sentry/effect": "catalog:",
    "@sentry/node": "catalog:",
    "@workos-inc/node": "10.11.0",
    "buffer": "6.0.3",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "hono": "^4.10.1",
    "http-status-codes": "^2.3.0",
    "jira.js": "^5.3.1",
    "jose": "^6.1.0",
    "ohash": "^2.0.11",
    "p-limit": "7.3.0",
    "postgres": "^3.4.8",
    "posthog-node": "5.46.1",
    "resend": "6.12.4",
    "stripe": "22.1.1",
    "uuidv7": "^1.2.1",
    "zod": "catalog:"
  },
  "devDependencies": {
