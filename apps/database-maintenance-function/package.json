{
  "name": "@humanlayer/database-maintenance-function",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build ./index.ts --outdir ./dist --target node --format cjs --minify",
    "cleanup:local": "bun --bun index.ts",
    "test": "bun vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test:watch": "bun vitest"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@humanlayer/db": "workspace:*",
    "@sentry/node": "^10.32.1",
    "drizzle-orm": "catalog:",
    "postgres": "^3.4.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.156",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@humanlayer/vitest-config": "workspace:*",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
