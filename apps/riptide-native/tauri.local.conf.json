{
  "productName": "HumanLayer-Local",
  "identifier": "com.humanlayer.riptide.local",
  "build": {
    "beforeBuildCommand": "bun run --cwd ../riptide-ui build:local && ([ -f ./bin/riptided ] || (bun run --cwd ../riptide-daemon build:local && cp ../riptide-daemon/dist/daemon ./bin/riptided))"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HumanLayer Local",
        "width": 1440,
        "height": 900,
        "center": true,
        "minWidth": 800,
        "minHeight": 600,
        "zoomHotkeysEnabled": true,
        "titleBarStyle": "Overlay",
        "transparent": true,
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["riptide-local"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1ODdERjg1OEVFRjVGQzcKUldUSFgrK09oZCtIbFhaRVBCT3FndG1CNEo0WUpFeWFDS2hDNmVQSzNQdERqeWpWbGVvV1JIRTAK",
      "endpoints": ["https://update.dev.codelayer.gg/dev/{{target}}-{{arch}}/{{current_version}}"]
    }
  }
}
