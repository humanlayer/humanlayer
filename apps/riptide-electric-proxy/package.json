{
  "name": "@humanlayer/riptide-electric-proxy",
  "license": "Apache-2.0",
  "exports": {
    "./server": "./src/server.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env run --watch src/index.ts",
    "dev:node-proxy": "node --env-file=../../.env --watch --import tsx src/index.ts",
    "build": "bun build ./src/index.ts ./src/instrument.mts --outdir ./dist --target node --format esm --sourcemap=linked --minify --entry-naming '[name].mjs'",
    "typecheck": "tsc --noEmit",
    "test": "bun vitest run",
    "test:watch": "bun vitest",
    "test:llm": "bun run ../../scripts/run-silent.ts 'tests passed' bun run test"
  },
  "dependencies": {
    "@humanlayer/db": "workspace:*",
    "@humanlayer/logger": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@electric-sql/client": "catalog:",
    "@hono/node-server": "^1.14.1",
    "@humanlayer/schemas": "workspace:*",
    "@humanlayer/streams": "workspace:*",
    "@humanlayer/y-durable-streams": "workspace:*",
    "@sentry/core": "catalog:",
    "@sentry/effect": "catalog:",
    "@sentry/node": "catalog:",
    "@workos-inc/node": "^7.77.0",
    "buffer": "6.0.3",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "hono": "^4.10.7",
    "http-status-codes": "^2.3.0",
    "jose": "^6.1.3",
    "ohash": "^2.0.11",
    "postgres": "^3.4.8",
    "undici": "8.3.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@humanlayer/test-fixtures": "workspace:*",
    "@humanlayer/vitest-config": "workspace:*",
    "@effect/vitest": "catalog:",
    "@tanstack/db": "catalog:",
    "@tanstack/electric-db-collection": "catalog:",
    "@types/bun": "latest",
    "@types/node": "catalog:",
    "@durable-streams/client": "catalog:",
    "yjs": "catalog:",
    "y-protocols": "catalog:",
    "lib0": "catalog:",
    "tsx": "4.22.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
