{
  "name": "@humanlayer/rpi",
  "version": "0.9.0",
  "description": "Research-Plan-Implement workflow CLI",
  "type": "module",
  "bin": {
    "rpi": "dist/rpi"
  },
  "exports": {
    ".": "./src/index.ts",
    "./config": {
      "types": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./lib": {
      "types": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    }
  },
  "files": [
    "dist/rpi",
    "README.md"
  ],
  "scripts": {
    "prepack": "rm -rf dist && bun run build",
    "build": "bun build ./src/index.ts --compile --target=bun --outfile=dist/rpi",
    "build:macos": "bun build ./src/index.ts --compile --target=bun-darwin-arm64 --outfile=dist/rpi",
    "build:linux": "bun build ./src/index.ts --compile --target=bun-linux-x64 --outfile=dist/rpi",
    "dev": "bun build ./src/index.ts --compile --watch --target=bun --outfile=dist/rpi",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun vitest run --project unit",
    "test:e2e": "bun vitest run --project e2e",
    "test:learning": "bun vitest run --project learning"
  },
  "dependencies": {
    "@humanlayer/linear-cli": "workspace:*",
    "@linear/sdk": "^1.22.0",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "effect": "catalog:",
    "git-client": "^1.9.4",
    "minimatch": "^10.1.1"
  },
  "devDependencies": {
    "@humanlayer/vitest-config": "workspace:*",
    "@types/node": "^24.9.1",
    "bun-types": "^1.3.5",
    "typescript": "^5.8.3",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=16"
  },
  "keywords": [
    "cli",
    "research",
    "planning",
    "workflow",
    "rpi"
  ],
  "author": "HumanLayer Authors",
  "license": "Apache-2.0"
}
