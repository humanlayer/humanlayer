{
  "name": "@humanlayer/riptide-daemon",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "exports": {
    "./start": "./src/start.ts",
    "./src/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "NODE_USE_SYSTEM_CA=1 RIPTIDE_DAEMON_FORCE_LOCAL_PLUGIN=true bun --bun --env-file=../../.env --watch run src/daemon.ts",
    "dev:node-proxy": "NODE_USE_SYSTEM_CA=1 RIPTIDE_DAEMON_FORCE_LOCAL_PLUGIN=true bun --bun --env-file=../../.env --watch run src/daemon.ts",
    "build": "bun run ./build.ts",
    "build:stable": "BUILD_TYPE=stable bun run build",
    "build:local": "BUILD_TYPE=local bun run build",
    "build:dev": "BUILD_TYPE=dev bun run build",
    "build:beta": "BUILD_TYPE=beta bun run build",
    "build:prod": "BUILD_TYPE=prod bun run build",
    "test": "bun vitest run --project unit",
    "test:learning": "bun vitest run --project learning",
    "test:llm": "bun run ../../scripts/run-silent.ts 'tests passed' bun run test",
    "test:integration": "bun vitest run --project integration",
    "test:real-claude": "bun vitest run test/integration/session-runner.test.ts test/unit/session-handlers.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@humanlayer/test-fixtures": "workspace:*",
    "@humanlayer/vitest-config": "workspace:*",
    "@durable-streams/server": "catalog:",
    "@effect/platform-node": "4.0.0",
    "@effect/vitest": "4.0.0",
    "@humanlayer/effect-ai-anthropic": "0.1.32",
    "@humanlayer/effect-ai-openai": "0.1.32",
    "@orpc/server": "catalog:",
    "@types/bun": "^1.3.4",
    "drizzle-orm": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.82",
