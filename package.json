{
  "name": "humanlayer",
  "devDependencies": {
    "@humanlayer/vitest-config": "workspace:*",
    "@durable-streams/cli": "catalog:",
    "@effect/tsgo": "0.36.4",
    "@electric-sql/pglite": "catalog:",
    "@oxlint/plugins": "1.77.0",
    "@socketsecurity/bun-security-scanner": "1.1.2",
    "@types/aws-lambda": "8.10.156",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.3.5",
    "node-gyp": "12.4.0",
    "oxfmt": "0.54.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "react-doctor": "0.9.13",
    "rimraf": "^6.0.1",
    "tsx": "4.23.9",
    "turbo": "2.8.1",
    "typescript": "7.0.2",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:linux": "turbo run build:linux ",
    "build:macos": "turbo run build:macos",
    "riptide:build:linux": "turbo run build:linux --filter=@humanlayer/riptide-native",
    "riptide:build:stable": "turbo run build:stable --filter=@humanlayer/riptide-native",
    "riptide:build:local": "turbo run build:local --filter=@humanlayer/riptide-native",
    "riptide:ci:stable": "turbo run build:stable --filter=@humanlayer/riptide-native",
    "riptide:ci:local": "turbo run build:local --filter=@humanlayer/riptide-native",
    "riptide:ci:dev": "turbo run build:dev --filter=@humanlayer/riptide-native",
    "riptide:ci:beta": "turbo run build:beta --filter=@humanlayer/riptide-native",
    "riptide:ci:prod": "turbo run build:prod --filter=@humanlayer/riptide-native",
    "riptide:build:dev": "turbo run build:dev --filter=@humanlayer/riptide-native",
    "riptide:build:beta": "turbo run build:beta --filter=@humanlayer/riptide-native",
    "riptide:build:prod": "turbo run build:prod --filter=@humanlayer/riptide-native",
    "lint": "oxlint apps packages contracts",
    "lint:fix": "oxlint apps packages contracts --fix --quiet",
    "format": "oxfmt --check 'apps/**/*.ts*' 'packages/**/*.ts*' 'contracts/**/*.ts*'",
    "format:write": "oxfmt 'apps/**/*.ts*' 'packages/**/*.ts*' 'contracts/**/*.ts*'",
    "quality": "bun run scripts/run-silent.ts 'quality passed' bash -c 'oxlint --quiet apps packages contracts && bun run format'",
    "quality:fix": "bun run lint:fix && bun run format:write",
    "check": "bun run typecheck && bun run quality && bun run check:sentry-closures && bun run check:zod",
    "check:sentry-closures": "bun run scripts/check-sentry-closures.ts",
    "check:zod": "bun run scripts/check-zod-version.ts",
    "githooks": "cp scripts/hooks/pre-push $(git rev-parse --git-common-dir)/hooks/pre-push && chmod +x $(git rev-parse --git-common-dir)/hooks/pre-push",
    "storybook": "turbo run storybook",
    "swagger": "turbo run swagger",
    "test": "bun run scripts/run-silent.ts 'tests passed' bun run test:local",
    "test:local": "bun run test:ci:unit && bun run test:local:services",
    "test:local:services": "bash -c \"set -euo pipefail; bun scripts/test-services-up.ts; trap 'bun scripts/test-services-down.ts' EXIT; bun scripts/test-services-wait.ts; bun --env-file=.env turbo run test --filter='@humanlayer/billing' --filter='@humanlayer/riptide-api' --filter='@humanlayer/test-fixtures' --filter='@humanlayer/riptide-electric-proxy' --filter='@humanlayer/stale-daemon-sweeper' --concurrency=3; bun --env-file=.env vitest run --config apps/riptide-daemon/vitest.config.ts --project database\"",
    "test:ci": "bun run test:ci:unit && bun run test:ci:services",
    "test:ci:unit": "bun --env-file=.env turbo run test --filter='!@humanlayer/billing' --filter='!@humanlayer/riptide-api' --filter='!@humanlayer/test-fixtures' --filter='!@humanlayer/riptide-electric-proxy' --filter='!@humanlayer/stale-daemon-sweeper'",
    "test:ci:services": "bash -c \"set -euo pipefail; bun scripts/test-services-up.ts; trap 'bun scripts/test-services-down.ts' EXIT; bun scripts/test-services-wait.ts; bun scripts/test-services-run.ts\"",
    "test:services:up": "bun scripts/test-services-up.ts",
    "test:services:wait": "bun scripts/test-services-wait.ts",
    "test:services:down": "bun scripts/test-services-down.ts",
    "typecheck": "bun run scripts/run-silent.ts 'typecheck passed' turbo run typecheck",
    "db:migrations:generate": "bun --cwd packages/db drizzle-kit generate",
    "devstack": "bun apps/devstack/src/cli.ts",
    "caddy": "bun scripts/ensure-devstack-caddy.ts",
    "riptide": "bun run --parallel caddy riptide:dev",
    "riptide:dev": "turbo run dev --filter @humanlayer/riptide-daemon --filter @humanlayer/riptide-api --filter @humanlayer/riptide-electric-proxy --filter @humanlayer/riptide-ui --filter @humanlayer/riptide-cloud --env-mode=loose",
    "riptide:node-proxy": "bun run --parallel caddy riptide:node-proxy:dev",
    "riptide:node-proxy:dev": "turbo run dev:node-proxy --filter @humanlayer/riptide-daemon --filter @humanlayer/riptide-api --filter @humanlayer/riptide-electric-proxy --filter @humanlayer/riptide-ui --filter @humanlayer/riptide-cloud --env-mode=loose",
    "riptide:headless": "bun run --parallel caddy riptide:headless:dev",
    "riptide:headless:dev": "turbo run dev --filter @humanlayer/riptide-api --filter @humanlayer/riptide-electric-proxy --filter @humanlayer/riptide-ui --filter @humanlayer/riptide-cloud --env-mode=loose",
    "riptide:native": "bun --bun run build --filter @humanlayer/riptide-daemon && cp apps/riptide-daemon/dist/daemon apps/riptide-native/bin/riptided && bun run --parallel caddy riptide:native:dev",
    "riptide:native:dev": "bun --bun turbo run dev --filter @humanlayer/riptide-ui --filter @humanlayer/riptide-cloud --filter @humanlayer/riptide-native --filter @humanlayer/riptide-electron --filter @humanlayer/riptide-api --filter @humanlayer/riptide-electric-proxy --filter @humanlayer/riptide-daemon --env-mode=loose",
    "riptide:electron": "bun run --parallel caddy riptide:electron:dev",
    "riptide:electron:dev": "bun --bun turbo run dev --filter @humanlayer/riptide-ui --filter @humanlayer/riptide-cloud --filter @humanlayer/riptide-electron --filter @humanlayer/riptide-api --filter @humanlayer/riptide-electric-proxy --filter @humanlayer/riptide-daemon --env-mode=loose",
    "riptide:electron:package": "bun --bun run --cwd=apps/riptide-electron package:local",
    "riptide:electron:package:dev": "bun --bun run --cwd=apps/riptide-electron package:dev",
    "riptide:electron:package:dev:unsigned": "bun --bun run --cwd=apps/riptide-electron package:dev:unsigned",
    "riptide:electron:test": "bun turbo run test --filter @humanlayer/riptide-electron",
    "hook:quality": "bun run quality",
    "hook:typecheck": "turbo run typecheck",
    "hook:prepush": "bun scripts/hook-prepush.ts && bunx react-doctor apps/riptide-ui --scope changed --blocking warning",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "dev:setup": "bun run prepare",
    "test:scripts": "bun vitest run",
    "test:anti-slop": "node --import tsx tools/oxlint/automation/rules/prefer-use-mount-effect.test.ts && node --import tsx tools/oxlint/automation/layer-provide-rules.test.ts && node --import tsx tools/oxlint/anti-slop/rules/max-ternary-depth.test.ts && node --import tsx tools/oxlint/anti-slop/rules/no-chained-type-assertions.test.ts && node --import tsx tools/oxlint/anti-slop/rules/no-conditional-spread.test.ts && node --import tsx tools/oxlint/anti-slop/rules/no-known-value-widening.test.ts && node --import tsx tools/oxlint/anti-slop/rules/no-object-parameters.test.ts && node --import tsx tools/oxlint/anti-slop/rules/no-reprovide-ambient-service.test.ts && node --import tsx tools/oxlint/anti-slop/rules/no-unknown-type-aliases.test.ts && node --import tsx tools/oxlint/anti-slop/rules/no-widen-then-assert.test.ts",
    "verify:agentlayer-release-provenance": "bun run scripts/verify-agentlayer-release-deps.ts",
    "doctor": "npx react-doctor@latest"
  },
  "workspaces": [
    "apps/*",
    "contracts/*",
    "packages/*",
    "vendor/*"
  ],
